class Python312CompatibilityHydrator:
    @staticmethod
    def apply_patches():
        try:
            import distutils
        except ImportError:
            import types
            distutils_mock = types.ModuleType("distutils")
            distutils_mock.version = types.ModuleType("distutils.version")
            sys.modules["distutils"] = distutils_mock
            sys.modules["distutils.version"] = distutils_mock.version

Python312CompatibilityHydrator.apply_patches()

