# FASE 4: SINTETIZADOR MULTIPOTENCIAL Y ORQUESTADOR zk-DAG
# ==============================================================================

class ARCSynthesizerEngine:
    def __init__(self):
        self.templates = [
            """
def transform(input_grid: np.ndarray) -> np.ndarray:
    return ARCDSL.rotate_90(input_grid)
""",
            """
def transform(input_grid: np.ndarray) -> np.ndarray:
    return ARCDSL.crop_to_content(input_grid, background=0)
""",
            """
def transform(input_grid: np.ndarray) -> np.ndarray:
    return ARCDSL.reflect_h(input_grid)
""",
            """
def transform(input_grid: np.ndarray) -> np.ndarray:
    return ARCDSL.reflect_v(input_grid)
""",
            """
def transform(input_grid: np.ndarray) -> np.ndarray:
    out = input_grid.copy()
    objects = ARCDSL.get_objects(input_grid)
    for obj in objects:
        if obj['size'] > 3:
            for r, c in obj['coords']:
                out[r, c] = (obj['color'] + 1) % 10
    return out
""",
            """
def transform(input_grid: np.ndarray) -> np.ndarray:
    return input_grid.copy()
"""
        ]

    def generate_hypotheses(self, task_data: Dict[str, Any]) -> List[str]:
        candidates = list(self.templates)
        train_pairs = task_data["train"]
        color_map = {}
        possible_recolor = True
        
        for pair in train_pairs:
            inp, out = pair["input"], pair["output"]
            if inp.shape == out.shape:
                unique_inp = set(np.unique(inp))
                for c in unique_inp:
                    out_colors = set(out[inp == c])
                    if len(out_colors) == 1:
                        color_map[int(c)] = int(list(out_colors)[0])
                    else:
                        possible_recolor = False
            else:
                possible_recolor = False

        if possible_recolor and color_map:
            mapping_str = json.dumps(color_map)
            dynamic_code = f"""
def transform(input_grid: np.ndarray) -> np.ndarray:
    out = input_grid.copy()
    mapping = {mapping_str}
    for src, dst in mapping.items():
        out[input_grid == src] = dst
    return out
"""
            candidates.insert(0, dynamic_code)

        return candidates

class RTX6000ZKDAGOrchestrator:
    def __init__(self, sandbox: RTX6000ParallelSandboxREPL):
        self.sandbox = sandbox
        self.synthesizer = ARCSynthesizerEngine()

    def calculate_v_u(self, fit: float, ast_nodes: int, exec_time: float, acu_energy: float = 0.1) -> float:
        if fit < 1.0:
            return 0.0
        alpha = 1e-3
        beta = 1e-4
        denominator = float(ast_nodes) + (alpha * (exec_time * 1000.0)) + (beta * acu_energy)
        return 1.0 / max(denominator, 1e-6)

    def solve_task(self, task_id: str, task_data: Dict[str, Any]) -> List[List[List[int]]]:
        logger.info(f"[RTX 6000 zk-DAG] Procesando Tarea {task_id} en paralelo...")
        train_pairs = task_data["train"]
        test_inputs = [pair["input"] for pair in task_data["test"]]
        
        hypotheses = self.synthesizer.generate_hypotheses(task_data)
        eval_results = self.sandbox.execute_batch(hypotheses, train_pairs)
        
        valid_nodes = []
        for res in eval_results:
            if res["success"]:
                v_u = self.calculate_v_u(fit=1.0, ast_nodes=res["ast_nodes"], exec_time=res["exec_time"])
                local_scope = {"np": np, "ARCDSL": ARCDSL}
                exec(res["code"], local_scope)
                valid_nodes.append({
                    "v_u": v_u,
                    "transform_fn": local_scope["transform"],
                    "code": res["code"]
                })

        valid_nodes.sort(key=lambda x: x["v_u"], reverse=True)

        results_per_test = []
        for test_idx, test_grid in enumerate(test_inputs):
            attempts = []
            if len(valid_nodes) >= 1:
                p1 = valid_nodes[0]["transform_fn"](test_grid.copy())
                attempts.append(p1.tolist())
            else:
                attempts.append(test_grid.copy().tolist())

            if len(valid_nodes) >= 2:
                p2 = valid_nodes[1]["transform_fn"](test_grid.copy())
                attempts.append(p2.tolist())
            else:
                try:
                    p2 = ARCDSL.crop_to_content(test_grid.copy())
                    if p2.shape == test_grid.shape and np.array_equal(p2, test_grid):
                        p2 = ARCDSL.rotate_90(test_grid.copy())
                except Exception:
                    p2 = test_grid.copy()
                attempts.append(p2.tolist())

            results_per_test.append(attempts)

        return results_per_test

