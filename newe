    if not os.path.exists(test_path):
        df = pd.DataFrame({'id': ['001'], 'problem': ['Calculate the number of positive integers n <= 1000 such that n^2 + n is divisible by 5.']})
    else:
        df = pd.read_csv(test_path)

    model_dir = "/kaggle/input/models/qwen-lm/qwq-32b-preview/transformers/default/1"
