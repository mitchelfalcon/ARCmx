    except Exception as e:
        logger.critical(f"[GATEWAY] Engine initialization failed completely: {e}. Writing safe zero-filled fallback submission.")
        fallback_df = pd.DataFrame({'id': df['id'], 'answer': [0] * len(df)})
        fallback_df.to_csv('/kaggle/working/submission.csv', index=False)
        return

    results = []
    total_problems = len(df)
    for idx, row in df.iterrows():
        prob_id = row['id']
        problem_text = row['problem']
        logger.info(f"[GATEWAY] Processing Problem [{idx + 1}/{total_problems}] ID: {prob_id}")
        
        try:
            ans = engine.solve_problem(problem_text)
        except Exception as e:
            logger.error(f"[GATEWAY] Graceful fallback triggered on ID {prob_id} due to: {e}")
            ans = 0
            
        results.append({'id': prob_id, 'answer': ans})

    sub_df = pd.DataFrame(results)
    sub_df.to_csv('/kaggle/working/submission.csv', index=False)
    logger.info("--- [GATEWAY] SUBMISSION SUCCESSFULLY GENERATED AT /kaggle/working/submission.csv ---")

if __name__ == "__main__":
    run_pipeline()