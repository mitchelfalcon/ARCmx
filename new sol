class MCPServerProtocol:
    """Implementación del protocolo MCP para enrutamiento de peticiones JSON-RPC 2.0."""

    @staticmethod
    def build_jsonrpc_request(method: str, params: Dict[str, Any], req_id: int) -> Dict[str, Any]:
        return {
            "jsonrpc": "2.0",
            "id": req_id,
            "method": method,
            "params": params
        }

class ARCSynthesizerEngine:
    """Generador Heurístico / Simbólico de Hipótesis de Código Python."""

    def __init__(self):
        self.templates = [
            # Plantilla 1: Transformación directa via DSL (Rotación/Reflexión)
            """
def transform(input_grid: np.ndarray) -> np.ndarray:
    return ARCDSL.rotate_90(input_grid)
""",
            # Plantilla 2: Recorte al contenido activo
            """
def transform(input_grid: np.ndarray) -> np.ndarray:
    return ARCDSL.crop_to_content(input_grid, background=0)
""",
            # Plantilla 3: Mapeo de color dominante por objeto
            """
def transform(input_grid: np.ndarray) -> np.ndarray:
    out = input_grid.copy()
    objects = ARCDSL.get_objects(input_grid)
    for obj in objects:
        if obj['size'] > 3:
            for r, c in obj['coords']:
                out[r, c] = (obj['color'] + 1) % 10
    return out
""",
            # Plantilla 4: Identidad pasiva (Fallback defensivo)
            """
def transform(input_grid: np.ndarray) -> np.ndarray:
    return input_grid.copy()
"""
        ]

    def generate_hypotheses(self, task_data: Dict[str, Any]) -> List[str]:
        """Produce candidatos utilizando descomposición de invariantes."""
        candidates = list(self.templates)
        
        # Detección dinámica de cambio de color constante
        train_pairs = task_data["train"]
        color_map = {}
        possible_recolor = True
        
        for pair in train_pairs:
            inp, out = pair["input"], pair["output"]
            if inp.shape == out.shape:
                unique_inp = set(np.unique(inp))
                for c in unique_inp:
                    out_colors = set(out[inp == c])
                    if len(out_colors) == 1:
                        color_map[int(c)] = int(list(out_colors)[0])
                    else:
                        possible_recolor = False
            else:
                possible_recolor = False

        if possible_recolor and color_map:
            mapping_str = json.dumps(color_map)
            dynamic_code = f"""
def transform(input_grid: np.ndarray) -> np.ndarray:
    out = input_grid.copy()
    mapping = {mapping_str}
    for src, dst in mapping.items():
        out[input_grid == src] = dst
    return out
"""
            candidates.insert(0, dynamic_code)

        return candidates

class ZKDAGOrchestrator:
    """Orquestador zk-DAG de Selección y Arbitraje Termodinámico V_u."""

    def __init__(self, sandbox: ARCSandboxREPL):
        self.sandbox = sandbox
        self.synthesizer = ARCSynthesizerEngine()

    def calculate_v_u(self, fit: float, ast_nodes: int, exec_time: float, acu_energy: float = 1.0) -> float:
        """Calcula la métrica de elegancia termodinámica V_u."""
        if fit < 1.0:
            return 0.0
        alpha = 1e-3
        beta = 1e-4
        denominator = float(ast_nodes) + (alpha * (exec_time * 1000.0)) + (beta * acu_energy)
        return 1.0 / max(denominator, 1e-6)

    def solve_task(self, task_id: str, task_data: Dict[str, Any]) -> List[List[List[int]]]:
        logger.info(f"[zk-DAG] Procesando Tarea {task_id}...")
        
        train_pairs = task_data["train"]
        test_inputs = [pair["input"] for pair in task_data["test"]]
        
        hypotheses = self.synthesizer.generate_hypotheses(task_data)
        valid_nodes = []

        for idx, code in enumerate(hypotheses):
            eval_result = self.sandbox.execute(code, train_pairs)
            if eval_result["success"]:
                v_u = self.calculate_v_u(
                    fit=1.0,
                    ast_nodes=eval_result["ast_nodes"],
                    exec_time=eval_result["exec_time"]
                )
                valid_nodes.append({
                    "v_u": v_u,
                    "transform_fn": eval_result["transform_fn"],
                    "code": code
                })

        # Ordenar nodos de acuerdo con el Cierre Termodinámico V_u
        valid_nodes.sort(key=lambda x: x["v_u"], reverse=True)

        results_per_test = []
        for test_idx, test_grid in enumerate(test_inputs):
            attempts = []
            
            if len(valid_nodes) >= 1:
                p1 = valid_nodes[0]["transform_fn"](test_grid.copy())
                attempts.append(p1.tolist())
            else:
                attempts.append(test_grid.copy().tolist())

            if len(valid_nodes) >= 2:
                p2 = valid_nodes[1]["transform_fn"](test_grid.copy())
                attempts.append(p2.tolist())
            else:
                # Fallback de intento 2: Aplicación de Crop o Identidad
                try:
                    p2 = ARCDSL.crop_to_content(test_grid.copy())
                    if p2.shape == test_grid.shape and np.array_equal(p2, test_grid):
                        p2 = ARCDSL.rotate_90(test_grid.copy())
                except Exception:
                    p2 = test_grid.copy()
                attempts.append(p2.tolist())

            results_per_test.append(attempts)

        return results_per_test

