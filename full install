### FASE 1: Script de Despliegue Offline (`deploy_platform.py`)

Este script realiza la instalación secuencial aislada evitando que `pip` intente conectarse a índices externos o resuelva binarios incompatibles.

```python
#!/usr/bin/env python3
"""
PROJECT SENTINEL - DEPLOY PLATFORM (PYTHON 3.12 / RTX 6000 ADA)
Responsibility: Isolated Offline Wheel Installation & Dependency Enforcement.
"""
import os
import sys
import subprocess
import logging
from pathlib import Path

logging.basicConfig(
    level=logging.INFO,
    format="[%(asctime)s] [%(levelname)s] %(message)s",
    datefmt="%H:%M:%S"
)
logger = logging.getLogger("SentinelDeployer")

class PlatformInstaller:
    """
    Gestor de despliegue offline para la plataforma NVIDIA RTX 6000 Ada (48GB VRAM).
    Asegura la compatibilidad con Python 3.12 (cp312) y CXX11 ABI False.
    """
    def __init__(self, wheels_dir: str = None):
        self.wheels_dir = Path(wheels_dir) if wheels_dir else None
        self.python_bin = sys.executable

        if sys.version_info[:2] != (3, 12):
            logger.warning(f"⚠️ Versión de Python detectada: {sys.version}. Se requiere Python 3.12 estrictamente.")

    def _run_command(self, cmd: str, description: str) -> bool:
        logger.info(f"Iniciando: {description}...")
        try:
            subprocess.run(
                cmd,
                shell=True,
                check=True,
                capture_output=True,
                text=True
            )
            logger.info(f"✅ Éxito: {description}")
            return True
        except subprocess.CalledProcessError as e:
            logger.error(f"❌ Fallo crítico en '{description}':\nSTDOUT: {e.stdout}\nSTDERR: {e.stderr}")
            return False

    def check_hardware(self):
        """Verifica la presencia y estado de la RTX 6000 Ada / Compute Capability 8.9."""
        logger.info("Comprobando entorno de GPU de Host...")
        try:
            nvidia_smi = subprocess.check_output("nvidia-smi", shell=True, text=True)
            if "RTX 6000" in nvidia_smi or "Ada" in nvidia_smi or "RTX" in nvidia_smi:
                logger.info("✅ GPU NVIDIA RTX 6000 Ada / Lovelace confirmada.")
            else:
                logger.warning("⚠️ Dispositivo detectado difiere de la especificación RTX 6000 Ada.")
        except Exception:
            logger.error("❌ 'nvidia-smi' no disponible. Revisa los controladores NVIDIA del Host.")

    def install_pipeline(self):
        self.check_hardware()

        if not self.wheels_dir or not self.wheels_dir.exists():
            raise FileNotFoundError(f"❌ No se encontró el directorio de wheels offline en: {self.wheels_dir}")

        base_pip = f"{self.python_bin} -m pip install --no-index --find-links={self.wheels_dir} "

        # 1. Actualización de Pip
        self._run_command(f"{self.python_bin} -m pip install --upgrade pip --quiet", "Actualización Interna de Pip")

        # 2. PyTorch Core (CUDA 12.4)
        logger.info("Instalando Core Framework (PyTorch 2.4.0+cu124)...")
        torch_cmd = base_pip + "torch torchvision torchaudio"
        if not self._run_command(torch_cmd, "Instalación de PyTorch Core"):
            raise RuntimeError("Fallo en la instalación del Core de PyTorch.")

        # 3. FlashAttention-2 (Wheel binario directo cp312)
        flash_wheels = list(self.wheels_dir.glob("flash_attn*cp312*.whl"))
        if flash_wheels:
            flash_cmd = base_pip + str(flash_wheels[0])
            self._run_command(flash_cmd, "Instalación de FlashAttention-2 (cp312/abiFALSE)")
        else:
            logger.warning("⚠️ Wheel de FlashAttention-2 cp312 no hallado. El motor usará PyTorch SDPA Nativo.")

        # 4. Motores de Inferencia, RAPIDS y SSM
        extra_pkgs = "vllm xformers cudf-cu12 cuml-cu12 dask-cudf-cu12 pydantic PyJWT reportlab networkx psutil safetensors transformers mamba-ssm causal-conv1d"
        self._run_command(base_pip + extra_pkgs, "Instalación de Motores Heterogéneos VRAM & RAPIDS")

        logger.info("🎉 ¡Despliegue de Plataforma Sentinel Completado!")

if __name__ == "__main__":
    WHEELS_PATH = "/kaggle/input/rtx-pro-wheels-dataset" if os.path.exists("/kaggle/input/rtx-pro-wheels-dataset") else "./rtx_pro_6000_wheels"
    installer = PlatformInstaller(wheels_dir=WHEELS_PATH)
    installer.install_pipeline()

```

