class RedTeamValidator:
    """Escanea el AST del código sintetizado para neutralizar bucles suicidas y OOM."""

    @classmethod
    def validate(cls, code_str: str) -> Tuple[bool, str]:
        try:
            tree = ast.parse(code_str)
            for node in ast.walk(tree):
                # Detención de bucles con rangos excesivos
                if isinstance(node, (ast.For, ast.While)):
                    snippet = ast.unparse(node)
                    if re.search(r'range\(\s*(10\*\*5|100000|10\*\*6|10\*\*7)', snippet):
                        return False, "AST_REJECTED: Rango de iteración potencialmente infinito/suicida."
                    if "while True" in snippet and "break" not in snippet:
                        return False, "AST_REJECTED: Bucle while True desprotegido."

                # Bloqueo de importaciones prohibidas
                if isinstance(node, (ast.Import, ast.ImportFrom)):
                    for alias in node.names:
                        if alias.name in ["socket", "urllib", "requests", "os", "subprocess", "shutil"]:
                            return False, f"AST_REJECTED: Importación de módulo prohibido ({alias.name})."

            return True, "AST_CLEAN"
        except SyntaxError as e:
            return False, f"AST_SYNTAX_ERROR: {str(e)}"
        except Exception as e:
            return False, f"AST_VALIDATION_ERROR: {str(e)}"

class ARCSandboxREPL:
    """Bucle REPL aislado con restricciones estrictas de recursos VRAM/RAM y CPU."""

    def __init__(self, memory_limit_mb: int = 2048, timeout_seconds: float = 3.0):
        self.memory_limit_bytes = memory_limit_mb * 1024 * 1024
        self.timeout_seconds = timeout_seconds

    def _apply_rlimits(self):
        """Aplica límites rigurosos de recursos dentro del proceso hijo."""
        resource.setrlimit(resource.RLIMIT_AS, (self.memory_limit_bytes, self.memory_limit_bytes))
        resource.setrlimit(resource.RLIMIT_CPU, (int(self.timeout_seconds) + 1, int(self.timeout_seconds) + 1))

    def execute(self, code_str: str, train_pairs: List[Dict[str, np.ndarray]]) -> Dict[str, Any]:
        valid, msg = RedTeamValidator.validate(code_str)
        if not valid:
            return {"success": False, "error": msg, "exec_time": 0.0, "ast_nodes": 0}

        try:
            ast_nodes = len(list(ast.walk(ast.parse(code_str))))
        except Exception:
            ast_nodes = 9999

        start_time = time.perf_counter()
        
        # Generación de namespace seguro
        local_scope = {"np": np, "ARCDSL": ARCDSL}
        global_scope = {"__builtins__": {
            "range": range, "len": len, "print": print, "int": int, "list": list,
            "dict": dict, "set": set, "tuple": tuple, "zip": zip, "enumerate": enumerate,
            "max": max, "min": min, "sum": sum, "abs": abs, "isinstance": isinstance
        }}

        try:
            exec(code_str, global_scope, local_scope)
            if "transform" not in local_scope or not callable(local_scope["transform"]):
                return {"success": False, "error": "La función 'transform(input_grid)' no fue definida.", "exec_time": 0.0, "ast_nodes": ast_nodes}

            transform_fn = local_scope["transform"]

            # Verificación determinista sobre el 100% de los pares de entrenamiento
            for pair in train_pairs:
                in_grid = pair["input"]
                expected_out = pair["output"]
                predicted_out = transform_fn(in_grid.copy())

                if not isinstance(predicted_out, np.ndarray):
                    return {"success": False, "error": "La función no retornó un numpy.ndarray.", "exec_time": time.perf_counter() - start_time, "ast_nodes": ast_nodes}

                if predicted_out.shape != expected_out.shape or not np.array_equal(predicted_out, expected_out):
                    return {"success": False, "error": "Fallo de coincidencia en retículo de entrenamiento.", "exec_time": time.perf_counter() - start_time, "ast_nodes": ast_nodes}

            exec_time = time.perf_counter() - start_time
            return {
                "success": True,
                "error": None,
                "exec_time": exec_time,
                "ast_nodes": ast_nodes,
                "transform_fn": transform_fn
            }

        except Exception as e:
            return {
                "success": False,
                "error": f"Runtime Execution Error: {str(e)}",
                "exec_time": time.perf_counter() - start_time,
                "ast_nodes": ast_nodes
            }

