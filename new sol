class ARCPrimeRunner:
    """Ejecutor End-to-End para el entorno de competición Kaggle."""

    def __init__(self, dataset_path: str = "/kaggle/input/arc-agi-2/arc-agi_evaluation_challenges.json"):
        self.dataset_path = Path(dataset_path)
        # Fallback para pruebas locales si la ruta de Kaggle no existe
        if not self.dataset_path.exists():
            self.dataset_path = Path("sample_tasks.json")
            self._create_dummy_dataset_if_missing()

        self.sandbox = ARCSandboxREPL(memory_limit_mb=2048, timeout_seconds=4.0)
        self.orchestrator = ZKDAGOrchestrator(self.sandbox)

    def _create_dummy_dataset_if_missing(self):
        dummy_data = {
            "007b1240": {
                "train": [
                    {"input": [[0, 1], [0, 0]], "output": [[1, 0], [0, 0]]},
                    {"input": [[0, 0], [2, 0]], "output": [[0, 0], [0, 2]]}
                ],
                "test": [
                    {"input": [[0, 3], [0, 0]]}
                ]
            }
        }
        with open(self.dataset_path, "w") as f:
            json.dump(dummy_data, f)

    def _load_tasks(self) -> Dict[str, Any]:
        with open(self.dataset_path, "r") as f:
            raw_data = json.load(f)
        
        formatted_tasks = {}
        for task_id, task in raw_data.items():
            formatted_tasks[task_id] = {
                "train": [
                    {"input": np.array(pair["input"], dtype=int), "output": np.array(pair["output"], dtype=int)}
                    for pair in task["train"]
                ],
                "test": [
                    {"input": np.array(pair["input"], dtype=int)}
                    for pair in task["test"]
                ]
            }
        return formatted_tasks

    def run(self):
        start_time = time.time()
        logger.info("[RUNNER] Cargando desafíos de ARC Prime...")
        tasks = self._load_tasks()
        submission_output = {}

        for task_id, task_data in tasks.items():
            # Control de tiempo global (Límite suave de 8.5 horas)
            elapsed = time.time() - start_time
            if elapsed > 30600:
                logger.warning("[SAFETY CRITICAL] Presupuesto de tiempo agotado. Ejecutando salida limpia...")
                break

            try:
                test_predictions = self.orchestrator.solve_task(task_id, task_data)
                
                # Reformateo estricto exigido por Kaggle: [{"attempt_1": ..., "attempt_2": ...}]
                task_submission = []
                for pred_pair in test_predictions:
                    task_submission.append({
                        "attempt_1": pred_pair[0],
                        "attempt_2": pred_pair[1]
                    })
                submission_output[task_id] = task_submission

            except Exception as e:
                logger.error(f"[TASK ERROR] Error procesando tarea {task_id}: {str(e)}")
                # Generación de fallback defensivo en caso de excepción severa
                fallback_submission = []
                for test_pair in task_data["test"]:
                    grid_list = test_pair["input"].tolist()
                    fallback_submission.append({
                        "attempt_1": grid_list,
                        "attempt_2": grid_list
                    })
                submission_output[task_id] = fallback_submission

        # Persistencia atómica de submission.json
        output_file = Path("/kaggle/working/submission.json")
        if not output_file.parent.exists():
            output_file = Path("submission.json")

        with open(output_file, "w") as f:
            json.dump(submission_output, f, indent=2)

        logger.info(f"[SUCCESS] Proceso finalizado. Archivo {output_file} generado con {len(submission_output)} tareas.")

if __name__ == "__main__":
    runner = ARCPrimeRunner()
    runner.run()

4. Instrucciones de Despliegue, Ejecución y Requisitos de Entorno
Step 1: Preparación del Datasets Utility Notebook (Offline Wheels)
 * Descarga localmente las ruedas (.whl) precompiladas requeridas que no estén disponibles en la imagen base de Kaggle (por ejemplo, vllm, pydantic, triton).
 * Crea un dataset privado en Kaggle nombrado aimo3-wheels-v2 y sube los archivos en la ruta /kaggle/input/datasets/naileafalcon/aimo3-wheels-v2/aimo_wheels_v2.
Step 2: Configuración del Notebook de Competición
 * Accelerator: Selecciona GPU NVIDIA H100 / T4 o CPU de Alto Rendimiento en el panel lateral de Kaggle.
 * Environment: Selecciona Always use latest environment.
 * Internet: Asegúrate de marcar Internet Disabled (Air-Gapped Mode) para simular las condiciones exactas de evaluación.
 * Attachments: Conecta el dataset oficial de la competición (arc-agi-2 / arc-agi-3) y tu dataset de dependencias offline aimo3-wheels-v2.
Step 3: Verificación Post-Ejecución y Trazabilidad de Auditoría
 * Verificación del Output: Al finalizar la ejecución, comprueba en la pestaña de archivos de /kaggle/working/ que el archivo submission.json esté presente y no tenga tamaño nulo (0\text{ bytes}).
 * Inspección de Logs: El sistema escribe un archivo de telemetría llamado arc_audit_logs.txt. Inspecciona este archivo para auditar las puntuaciones V_u calculadas, la memoria VRAM retenida y los scripts bloqueados por el filtro AST Red Team.
