### FASE 2: Inyección de Arquitectura y Guardián de Memoria (`inject_architecture.py`)

Este script se ejecuta en la celda inicial del notebook. Configura el bus PCIe Ada, intercepta OOMs en la VRAM de 48 GB y fuerza el cómputo en **BFloat16 / TF32**.

```python
#!/usr/bin/env python3
"""
PROJECT SENTINEL - RUNTIME INJECTOR & ADA MEMORY GUARD
Responsibility: Environment Injection, OOM Recovery, and Precision Tuning for RTX 6000 Ada (48 GB).
"""
import os
import sys
import gc
import functools
import logging

# ---------------------------------------------------------------------------
# FASE 1: INYECCIÓN DE VARIABLES DE ENTORNO CRÍTICAS (Antes de importar torch)
# ---------------------------------------------------------------------------
os.environ["NCCL_P2P_LEVEL"] = "PHB"                        # Interconexión P2P para bus PCIe G4/G5
os.environ["NCCL_DEBUG"] = "ERROR"                          # Silenciar verbosidad innecesaria
os.environ["CUDA_DEVICE_MAX_CONNECTIONS"] = "1"            # Optimizar cola de comandos en Ada Lovelace
os.environ["PYTORCH_CUDA_ALLOC_CONF"] = (
    "expandable_segments:True,"                            # Evita fragmentación en los 48 GB VRAM
    "max_split_size_mb:512,"                               # Control de bloques masivos
    "garbage_collection_threshold:0.8"                     # Purgado automático al alcanzar 80% VRAM
)
os.environ["TORCH_NCCL_ASYNC_ERROR_HANDLING"] = "1"
os.environ["NUMEXPR_MAX_THREADS"] = "8"

print("==================================================================")
print("🚀 [SENTINEL INJECTOR] Entorno de Kernel Configurado para RTX 6000 Ada")
print("==================================================================")

import torch

# ---------------------------------------------------------------------------
# FASE 2: MONKEY PATCHING Y INTERCEPTOR DE ERRORES OOM
# ---------------------------------------------------------------------------
def global_vram_cleanup():
    """Ejecuta purga agresiva de memoria en la VRAM de 48 GB."""
    gc.collect()
    if torch.cuda.is_available():
        torch.cuda.empty_cache()
        torch.cuda.ipc_collect()

def patch_oom_recovery(func):
    """
    Decorador Guardián: Intercepta picos de OutOfMemoryError en operaciones matriciales,
    purgando búfers VRAM y reintentando inmediatamente antes de que el Kernel falle.
    """
    @functools.wraps(func)
    def wrapper(*args, **kwargs):
        try:
            return func(*args, **kwargs)
        except torch.cuda.OutOfMemoryError as oom_err:
            print(f"\n🚨 [OOM INTERCEPTADO EN '{func.__name__}'] Purgando VRAM de 48GB y reintentando...")
            global_vram_cleanup()
            try:
                return func(*args, **kwargs)
            except torch.cuda.OutOfMemoryError:
                print(f"💥 [OOM PERSISTENTE EN '{func.__name__}'] Memoria VRAM Insuficiente.")
                raise oom_err
    return wrapper

# Aplicar el parche sobre la función primaria de multiplicación de matrices
torch.matmul = patch_oom_recovery(torch.matmul)

# ---------------------------------------------------------------------------
# FASE 3: CONFIGURACIÓN RUNTIME OPTIMIZADA PARA ADA LOVELACE (CC 8.9)
# ---------------------------------------------------------------------------
def configure_hardware_runtime():
    if not torch.cuda.is_available():
        raise SystemError("❌ CRÍTICO: CUDA no está activo. Verifica la asignación de la RTX 6000 Ada.")

    props = torch.cuda.get_device_properties(0)
    vram_gb = props.total_memory / (1024 ** 3)

    print(f"• Dispositivo: {props.name}")
    print(f"• Capacidad VRAM: {vram_gb:.2f} GB")
    print(f"• Compute Capability: {props.major}.{props.minor}")

    # 1. Habilitar Tensor Cores FP32/TF32
    torch.set_float32_matmul_precision('high')

    # 2. Configurar Backends de Atención Escalada (SDPA)
    torch.backends.cuda.enable_flash_sdp(True)
    torch.backends.cuda.enable_mem_efficient_sdp(True)
    torch.backends.cuda.enable_math_sdp(False)  # Bloquea degradaciones lentas a CPU

    # 3. Validar BFloat16 Nativo (Requerido para Ada Lovelace)
    if torch.cuda.is_bf16_supported():
        print("✅ Precision BFloat16 Nativa: ACTIVADA")
    else:
        print("⚠️ Advertencia: BFloat16 no disponible nativamente.")

    torch.cuda.reset_peak_memory_stats()
    print("==================================================================")
    print("✅ [INYECCIÓN COMPLETADA] Motor protegido contra OOM y caídas de Kernel")
    print("==================================================================")

configure_hardware_runtime()

```

