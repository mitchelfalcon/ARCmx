# ==============================================================================

WHEELS_BASE = Path("/kaggle/input/rtx6000-wheels-v1")
BOOTSTRAP_PREFIX = "[BOOTSTRAP OFFLINE PYTHON 3.12]"

TIERS = [
    "tier_0_cuda",
    "tier_1_tensor",
    "tier_2_transformers"
]

def verify_and_deploy_offline_environment():
    print(f"{BOOTSTRAP_PREFIX} Verificando directorios de dependencias offline por Tiers...")
    if not WHEELS_BASE.exists():
        raise FileNotFoundError(
            f"{BOOTSTRAP_PREFIX} [CRÍTICO] El directorio base {WHEELS_BASE} no está montado. "
            "Asegúrate de agregar el dataset 'rtx6000-wheels-v1' al notebook de Kaggle."
        )

    for tier in TIERS:
        tier_path = WHEELS_BASE / tier
        if not tier_path.exists():
            print(f"{BOOTSTRAP_PREFIX} [ADVERTENCIA] El subdirectorio {tier} no existe.")
            continue
            
        wheels = list(tier_path.glob("*.whl"))
        if not wheels:
            print(f"{BOOTSTRAP_PREFIX} [ADVERTENCIA] No hay archivos .whl en {tier}.")
            continue

        print(f"{BOOTSTRAP_PREFIX} Instalando paquetes de {tier.upper()} ({len(wheels)} archivos)...")
        cmd = [
            sys.executable, "-m", "pip", "install",
            "--no-index",
            f"--find-links={tier_path}",
            "--no-deps",
            "--no-warn-script-location",
            "--quiet",
            *[str(w) for w in wheels]
        ]
        
        result = subprocess.run(cmd, capture_output=True, text=True)
        if result.returncode != 0:
            err = result.stderr.strip() if result.stderr else "Error desconocido"
            raise RuntimeError(f"{BOOTSTRAP_PREFIX} Fallo crítico instalando {tier}: {err}")
        else:
            print(f"{BOOTSTRAP_PREFIX} {tier.upper()} instalado correctamente.")

verify_and_deploy_offline_environment()

