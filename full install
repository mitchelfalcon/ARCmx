### FASE 3: Hidratador Nativo del Motor Cognitivo (`sentinel_engine_core.py`)

Nailea, este es la **adaptación directa de tu script `MARDUK/KANISH**`, refinado para aprovechar la velocidad real de la **RTX 6000 Ada**.

A diferencia de la T4, aquí usaremos **`torch.bfloat16` nativo**, intentaremos utilizar los kernels acelerados de C++/CUDA en VRAM (`causal_conv1d_cuda`, `selective_scan_cuda`), y si falta algún binario en el entorno offline, aplicará el protocolo de rescate transparente sin detener la ejecución.

```python
#!/usr/bin/env python3
"""
PROJECT SENTINEL ENGINE (V26.0 - ADA EDITION)
Responsibility: High-Throughput Model Hydration, BFloat16 Tensor Alignment, and Memory-Safe Ingestion.
"""
import os
import sys
import json
import logging
import inspect
from pathlib import Path
from types import ModuleType

# Importar inyector preventivo
import inject_architecture

import torch

logging.basicConfig(level=logging.INFO, format="%(asctime)s | %(levelname)s | %(message)s")
logger = logging.getLogger("Sentinel_Engine_Core")

class AdaRescueProtocol:
    """
    Protocolo Transparente de Rescate para C++ Kernels.
    Si los binarios C++ están presentes, usa máxima aceleración.
    Si faltan en el paquete offline, inyecta fallbacks nativos de PyTorch sin colapsar.
    """
    @staticmethod
    def verify_or_patch_kernels():
        logger.info("--- [SYS] VERIFICANDO KERNELS C++/CUDA EN VRAM ---")
        
        # Probar si los kernels C++ nativos están compilados y accesibles
        try:
            import selective_scan_cuda
            import causal_conv1d_cuda
            logger.info("✅ Kernels C++/CUDA Fused detectados nativamente. Modo Máximo Throughput Activo.")
        except ImportError:
            logger.warning("⚠️ Kernels C++ Fused no encontrados. Aplicando 'Graph Surgery' a fallbacks nativos PyTorch...")
            
            # Mock de módulos faltantes
            for mod_name in ["selective_scan_cuda", "layer_norm_cuda", "causal_conv1d_cuda"]:
                if mod_name not in sys.modules:
                    sys.modules[mod_name] = ModuleType(mod_name)

            import mamba_ssm.ops.selective_scan_interface as ssi
            import mamba_ssm.ops.triton.layer_norm as mamba_ln
            import mamba_ssm.modules.mamba_simple as ms
            from mamba_ssm.ops.selective_scan_interface import selective_scan_ref, mamba_inner_ref

            ssi.selective_scan_fn = selective_scan_ref
            ssi.mamba_inner_fn = mamba_inner_ref
            ms.selective_scan_fn = selective_scan_ref
            ms.mamba_inner_fn = mamba_inner_ref
            ms.causal_conv1d_fn = None
            ms.causal_conv1d_update = None

            def layer_norm_fn_native(x, weight, bias, residual=None, eps=1e-5, is_rms_norm=False, **kwargs):
                dtype = x.dtype
                if is_rms_norm:
                    out = (x * torch.rsqrt(x.pow(2).mean(-1, keepdim=True) + eps)) * weight
                else:
                    out = torch.nn.functional.layer_norm(x.float(), x.shape[-1:], weight.float(), bias.float(), eps).to(dtype)
                return (out + residual if residual is not None else out), residual

            mamba_ln.layer_norm_fn = layer_norm_fn_native
            logger.info("[OK] Parches de cómputo nativos aplicados correctamente.")

class SentinelCoreHydrator:
    """
    Orquestador de Hidratación en VRAM (48 GB RTX 6000 Ada).
    Configura BFloat16, realiza alineación de Safetensors y amarra pesos (Weight Tying).
    """

    # RUTA LOCAL DEL MODELO EN EL ENTORNO OFFLINE / KAGGLE
    MODEL_DIR = "/kaggle/input/datasets/naileafalcon/kanish-wheels-py312/full_dev/full_dev/mamba/mamba_130m_model"

    @classmethod
    def hydrate_model(cls, custom_model_path: str = None):
        target_path = Path(custom_model_path if custom_model_path else cls.MODEL_DIR)

        # 1. Ejecutar verificación de parches antes de cargar el modelo
        AdaRescueProtocol.verify_or_patch_kernels()

        # 2. Configurar dispositivo y precisión óptima para Ada Lovelace
        if not torch.cuda.is_available():
            logger.error("[CRÍTICO] CUDA no detectado. Revisa la GPU asignada.")
            device = "cpu"
            dtype = torch.float32
        else:
            device = "cuda:0"
            # En RTX 6000 Ada preferimos BFloat16 sobre FP16 por rango dinámico
            dtype = torch.bfloat16 if torch.cuda.is_bf16_supported() else torch.float16

        from mamba_ssm.models.mixer_seq_simple import MambaLMHeadModel
        from mamba_ssm.models.config_mamba import MambaConfig
        from transformers import AutoTokenizer
        from safetensors.torch import load_file

        if not target_path.exists():
            raise FileNotFoundError(f"❌ La ruta del modelo no existe: {target_path}")

        # 3. Cargar Configuración y Limpiar Parámetros incompatible
        with open(target_path / "config.json", "r") as f:
            raw_cfg = json.load(f)

        sig = inspect.signature(MambaConfig.__init__)
        allowed_keys = [p for p in sig.parameters if p != 'self']
        raw_cfg['d_model'] = raw_cfg.get('hidden_size', 768)
        raw_cfg['n_layer'] = raw_cfg.get('num_hidden_layers', 24)
        config = MambaConfig(**{k: v for k, v in raw_cfg.items() if k in allowed_keys})

        logger.info(f"--- [SYS] HIDRATANDO MOTOR COGNITIVO EN VRAM ({dtype} | {device} | RTX 6000 ADA) ---")

        # 4. Carga de Safetensors y Re-alineación de Namespaces
        safetensor_file = target_path / "model.safetensors"
        if not safetensor_file.exists():
            # Buscar variante binaria de pytorch
            safetensor_file = target_path / "pytorch_model.bin"
            sd = torch.load(safetensor_file, map_location="cpu")
        else:
            sd = load_file(str(safetensor_file), device="cpu")

        # Re-mapeo para coincidir con MambaLMHeadModel
        new_sd = {
            k.replace("backbone.embeddings.", "backbone.embedding.").replace("model.", ""): v.to(dtype) 
            for k, v in sd.items()
        }

        # 5. Carga Segura en VRAM
        with torch.inference_mode():
            model = MambaLMHeadModel(config, device=device, dtype=dtype)
            missing, unexpected = model.load_state_dict(new_sd, strict=False)

            # Amarre manual de pesos si lm_head no viene explícito
            if "lm_head.weight" in missing:
                model.lm_head.weight = model.backbone.embedding.weight
                logger.info("[OK] Weight Tying ejecutado: 'lm_head.weight' enlazado a 'embedding.weight'.")

            model.eval()

            try:
                tokenizer = AutoTokenizer.from_pretrained(str(target_path))
            except Exception as e:
                logger.error(f"[ERROR] No se pudo cargar el tokenizer desde {target_path}: {e}")
                raise e

        vram_used = torch.cuda.memory_allocated(0) / (1024 ** 2)
        logger.info(f"[OK] Motor Sentinel listo en RTX 6000 Ada. Uso inicial VRAM: {vram_used:.2f} MB")
        return model, tokenizer

if __name__ == "__main__":
    # Prueba interactiva
    model, tokenizer = SentinelCoreHydrator.hydrate_model()
    print("\n[SENTINEL ENGINE] Listo para procesar inferencias.")

