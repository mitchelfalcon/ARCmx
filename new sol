class ARCDSL:
    """Dominio de Primitivas Algorítmicas y Operaciones Topológicas para ARC."""

    @staticmethod
    def rotate_90(grid: np.ndarray) -> np.ndarray:
        return np.rot90(grid, k=-1)

    @staticmethod
    def reflect_h(grid: np.ndarray) -> np.ndarray:
        return np.fliplr(grid)

    @staticmethod
    def reflect_v(grid: np.ndarray) -> np.ndarray:
        return np.flipud(grid)

    @staticmethod
    def get_objects(grid: np.ndarray, background: int = 0) -> List[Dict[str, Any]]:
        """Extrae componentes conexas (4-conectividad) ignorando el color de fondo."""
        visited = np.zeros_like(grid, dtype=bool)
        objects = []
        rows, cols = grid.shape

        for r in range(rows):
            for c in range(cols):
                if grid[r, c] != background and not visited[r, c]:
                    color = grid[r, c]
                    coords = []
                    queue = [(r, c)]
                    visited[r, c] = True

                    while queue:
                        curr_r, curr_c = queue.pop(0)
                        coords.append((curr_r, curr_c))
                        for dr, dc in [(-1,0), (1,0), (0,-1), (0,1)]:
                            nr, nc = curr_r + dr, curr_c + dc
                            if 0 <= nr < rows and 0 <= nc < cols:
                                if not visited[nr, nc] and grid[nr, nc] == color:
                                    visited[nr, nc] = True
                                    queue.append((nr, nc))

                    min_r = min(rr for rr, _ in coords)
                    max_r = max(rr for rr, _ in coords)
                    min_c = min(cc for _, cc in coords)
                    max_c = max(cc for _, cc in coords)

                    obj_subgrid = grid[min_r:max_r+1, min_c:max_c+1]
                    objects.append({
                        "color": int(color),
                        "coords": coords,
                        "bbox": (min_r, max_r, min_c, max_c),
                        "shape": obj_subgrid.shape,
                        "size": len(coords)
                    })
        return objects

    @staticmethod
    def crop_to_content(grid: np.ndarray, background: int = 0) -> np.ndarray:
        """Recorta la matriz eliminando bordes homogéneos del fondo."""
        non_bg = np.argwhere(grid != background)
        if non_bg.size == 0:
            return grid
        min_r, min_c = non_bg.min(axis=0)
        max_r, max_c = non_bg.max(axis=0)
        return grid[min_r:max_r+1, min_c:max_c+1]

    @staticmethod
    def replace_color(grid: np.ndarray, src_color: int, dst_color: int) -> np.ndarray:
        res = grid.copy()
        res[res == src_color] = dst_color
        return res

