class RedTeamASTValidator(ast.NodeVisitor):
    def __init__(self):
        self.violations = []

    def visit_For(self, node):
        self.generic_visit(node)
    
    def visit_While(self, node):
        self.generic_visit(node)

    def visit_Call(self, node):
        if isinstance(node.func, ast.Name) and node.func.id == 'range':
            if len(node.args) == 1 and isinstance(node.args[0], ast.Constant):
                if node.args[0].value > 100000:
                    self.violations.append(f"Forbidden large range limit detected: {node.args[0].value}")
        self.generic_visit(node)

    @classmethod
    def validate_code(cls, code_str: str) -> bool:
        try:
            tree = ast.parse(code_str)
            validator = cls()
            validator.visit(tree)
            if validator.violations:
                return False
            return True
        except Exception:
            return False

class SecureExecutionEngine:
    @staticmethod
    def execute_python_tir(code_string: str, timeout: int = 5) -> Tuple[str, bool]:
        if not RedTeamASTValidator.validate_code(code_string):
            return "AST_VIOLATION_BLOCKED", False

        def limit_resources():
            try:
                resource.setrlimit(resource.RLIMIT_AS, (4 * 1024**3, 4 * 1024**3))
            except Exception:
                pass

        with tempfile.NamedTemporaryFile(mode='w', suffix='.py', delete=False) as f:
            f.write("import sys\nsys.set_int_max_str_digits(0)\n" + code_string)
            temp_name = f.name

        try:
            result = subprocess.run(
                [sys.executable, temp_name],
                capture_output=True,
                text=True,
                timeout=timeout,
                preexec_fn=limit_resources
            )
            if result.returncode == 0:
                output = result.stdout.strip().splitlines()
                if output:
                    return output[-1], True
            return result.stderr.strip(), False
        except subprocess.TimeoutExpired:
            return "TIMEOUT", False
        except Exception as e:
            return str(e), False
        finally:
            if os.path.exists(temp_name):
                os.remove(temp_name)

class AIMO3ApexEngineRTX6000:
    def __init__(self, model_path: str):
        self.model_path = model_path
        self.llm = None
        self.sampling_params = None
        self._init_vllm()

    def _init_vllm(self):
        logger.info("[ENGINE] Initializing vLLM Inference Engine optimized for NVIDIA RTX 6000 (48GB VRAM)...")
        from vllm import LLM, SamplingParams
        self.llm = LLM(
            model=self.model_path,
            tensor_parallel_size=1,
            gpu_memory_utilization=0.88,
            enforce_eager=True,
            max_model_len=8192
        )
        self.sampling_params = SamplingParams(
            temperature=0.6,
            top_p=0.95,
            max_tokens=6000,
            n=5
        )

    def extract_pure_integer(self, text: str) -> int:
        boxed_matches = re.findall(r'\\boxed\{([^}]+)\}', text)
        if boxed_matches:
            clean_val = re.sub(r'[^0-9-]', '', boxed_matches[-1])
            if clean_val:
                try:
                    return int(clean_val) % 100000
                except ValueError:
                    pass
        
        numbers = re.findall(r'\b\d+\b', text)
        if numbers:
            return int(numbers[-1]) % 100000
        return 0

    def verify_answer_with_judge(self, problem_text: str, candidate_answer: int) -> bool:
        if not self.llm:
            return True
        prompt = f"Problem:\n{problem_text}\n\nProposed Answer: {candidate_answer}\nIs this answer mathematically correct? Answer with exactly one word: CORRECT or WRONG."
        try:
            outputs = self.llm.generate([prompt], self.sampling_params)
            for output in outputs[0].outputs:
                if "CORRECT" in output.text.upper():
                    return True
        except Exception:
            pass
        return False

    def solve_problem(self, problem_text: str) -> int:
        gc.disable()
        try:
            prompt = IRONCLAD_SYSTEM_PROMPT + f"\n\n### PROBLEM STATEMENT:\n{problem_text}"
            outputs = self.llm.generate([prompt], self.sampling_params)
            
            candidates = []
            for output in outputs[0].outputs:
                text = output.text
                code_match = re.search(r'```python(.*?)```', text, re.DOTALL)
                
                exec_success = False
                ans = 0
                if code_match:
                    code_str = code_match.group(1)
                    res, success = SecureExecutionEngine.execute_python_tir(code_str)
                    if success:
                        try:
                            ans = int(re.sub(r'[^0-9-]', '', res)) % 100000
                            exec_success = True
                        except ValueError:
                            pass
                    else:
                        corrector_prompt = prompt + f"\n\nYour previous code failed with:\n{res}\nFix the code and output the correct final integer."
                        corr_outputs = self.llm.generate([corrector_prompt], self.sampling_params)
                        if corr_outputs and corr_outputs[0].outputs:
                            corr_text = corr_outputs[0].outputs[0].text
                            corr_match = re.search(r'```python(.*?)```', corr_text, re.DOTALL)
                            if corr_match:
                                res_corr, success_corr = SecureExecutionEngine.execute_python_tir(corr_match.group(1))
                                if success_corr:
                                    try:
                                        ans = int(re.sub(r'[^0-9-]', '', res_corr)) % 100000
                                        exec_success = True
                                        text = corr_text
                                    except ValueError:
                                        pass
                
                if not exec_success:
                    ans = self.extract_pure_integer(text)
                
                weight = 1.5 if exec_success else 0.5
                candidates.append((ans, weight, text))

            if not candidates:
                return 0

            vote_weights = defaultdict(float)
            for ans, weight, _ in candidates:
                vote_weights[ans] += weight

            sorted_candidates = sorted(vote_weights.items(), key=lambda x: x[1], reverse=True)
            top_answer = sorted_candidates[0][0]

            if self.verify_answer_with_judge(problem_text, top_answer):
                return top_answer
            
            return top_answer
        finally:
            gc.enable()
            gc.collect()

