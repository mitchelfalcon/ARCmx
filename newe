        wheels_paths = [
            "/kaggle/input/rtx6000-wheels-v1",
            "/kaggle/input/datasets/naileafalcon/aimo3-wheels-v2/aimo_wheels_v2",
            "/kaggle/input/aimo3-wheels-v2"
        ]
        
        target_wheels_dir = None
        for path in wheels_paths:
            if os.path.exists(path):
                target_wheels_dir = path
                break

        if not target_wheels_dir:
            logger.warning("[ENV] Offline wheel directory not found in known paths. Falling back to active site-packages.")
            return HybridTopologyAssembler._verify_critical_packages()

        logger.info(f"[ENV] Discovered offline wheel repository at: {target_wheels_dir}")
        
        # Purge conflicting layers gracefully
        subprocess.run(
            [sys.executable, "-m", "pip", "uninstall", "-y", "tensorflow", "matplotlib", "keras", "scikit-learn"],
            capture_output=True, text=True
        )

        install_result = subprocess.run(
            [
                sys.executable, "-m", "pip", "install", 
                "--no-index", "--find-links", target_wheels_dir,
                "vllm", "transformers", "polars", "sympy", "protobuf==3.20.3"
            ],
            capture_output=True, text=True
        )

        if install_result.returncode == 0:
            logger.info("[ENV] Offline air-gapped dependencies successfully verified and installed.")
            return True
        else:
            logger.error(f"[ENV] Local wheel installation encountered issues: {install_result.stderr}")
            return HybridTopologyAssembler._verify_critical_packages()

    @staticmethod
    def _verify_critical_packages() -> bool:
        critical_modules = ["vllm", "transformers", "polars", "sympy", "google.protobuf"]
        missing = []
        for mod in critical_modules:
            try:
                __import__(mod)
            except ImportError:
                missing.append(mod)
        
        if missing:
            logger.critical(f"[ENV] Critical packages missing and unrecoverable: {missing}")
            return False
        logger.info("[ENV] All critical packages verified via system fallback.")
