# FASE 3: AUDITORÍA RED TEAM Y SANDBOX REPL CON AMPLIACIÓN DE RECURSOS (8 GB)
# ==============================================================================

class RedTeamValidator:
    @classmethod
    def validate(cls, code_str: str) -> Tuple[bool, str]:
        try:
            tree = ast.parse(code_str)
            for node in ast.walk(tree):
                if isinstance(node, (ast.For, ast.While)):
                    snippet = ast.unparse(node)
                    if re.search(r'range\(\s*(10\*\*6|1000000|10\*\*7)', snippet):
                        return False, "AST_REJECTED: Bucle excesivo detectado."
                    if "while True" in snippet and "break" not in snippet:
                        return False, "AST_REJECTED: Bucle while True sin condición de salida."

                if isinstance(node, (ast.Import, ast.ImportFrom)):
                    for alias in node.names:
                        if alias.name in ["socket", "urllib", "requests", "os", "subprocess", "shutil"]:
                            return False, f"AST_REJECTED: Módulo no permitido ({alias.name})."

            return True, "AST_CLEAN"
        except SyntaxError as e:
            return False, f"AST_SYNTAX_ERROR: {str(e)}"
        except Exception as e:
            return False, f"AST_VALIDATION_ERROR: {str(e)}"

def _standalone_execution_worker(args: Tuple[str, List[Dict[str, np.ndarray]], int, float]) -> Dict[str, Any]:
    code_str, train_pairs, memory_limit_mb, timeout_seconds = args
    mem_bytes = memory_limit_mb * 1024 * 1024
    try:
        resource.setrlimit(resource.RLIMIT_AS, (mem_bytes, mem_bytes))
        resource.setrlimit(resource.RLIMIT_CPU, (int(timeout_seconds) + 1, int(timeout_seconds) + 1))
    except Exception:
        pass

    valid, msg = RedTeamValidator.validate(code_str)
    if not valid:
        return {"success": False, "error": msg, "exec_time": 0.0, "ast_nodes": 0, "code": code_str}

    try:
        ast_nodes = len(list(ast.walk(ast.parse(code_str))))
    except Exception:
        ast_nodes = 9999

    start_time = time.perf_counter()
    local_scope = {"np": np, "ARCDSL": ARCDSL}
    global_scope = {"__builtins__": {
        "range": range, "len": len, "print": print, "int": int, "list": list,
        "dict": dict, "set": set, "tuple": tuple, "zip": zip, "enumerate": enumerate,
        "max": max, "min": min, "sum": sum, "abs": abs, "isinstance": isinstance
    }}

    try:
        exec(code_str, global_scope, local_scope)
        if "transform" not in local_scope or not callable(local_scope["transform"]):
            return {"success": False, "error": "Función transform no encontrada.", "exec_time": 0.0, "ast_nodes": ast_nodes, "code": code_str}

        transform_fn = local_scope["transform"]

        for pair in train_pairs:
            in_grid = pair["input"]
            expected_out = pair["output"]
            predicted_out = transform_fn(in_grid.copy())

            if not isinstance(predicted_out, np.ndarray):
                return {"success": False, "error": "Retorno no es numpy.ndarray.", "exec_time": time.perf_counter() - start_time, "ast_nodes": ast_nodes, "code": code_str}

            if predicted_out.shape != expected_out.shape or not np.array_equal(predicted_out, expected_out):
                return {"success": False, "error": "Mismatch en par de entrenamiento.", "exec_time": time.perf_counter() - start_time, "ast_nodes": ast_nodes, "code": code_str}

        exec_time = time.perf_counter() - start_time
        return {
            "success": True,
            "error": None,
            "exec_time": exec_time,
            "ast_nodes": ast_nodes,
            "code": code_str
        }

    except Exception as e:
        return {
            "success": False,
            "error": f"Runtime Execution Error: {str(e)}",
            "exec_time": time.perf_counter() - start_time,
            "ast_nodes": ast_nodes,
            "code": code_str
        }

class RTX6000ParallelSandboxREPL:
    def __init__(self, memory_limit_mb: int = 8192, timeout_seconds: float = 3.0, max_workers: int = 12):
        self.memory_limit_mb = memory_limit_mb
        self.timeout_seconds = timeout_seconds
        self.max_workers = max_workers

    def execute_batch(self, candidate_codes: List[str], train_pairs: List[Dict[str, np.ndarray]]) -> List[Dict[str, Any]]:
        tasks = [
            (code, train_pairs, self.memory_limit_mb, self.timeout_seconds)
            for code in candidate_codes
        ]
        results = []
        with ProcessPoolExecutor(max_workers=self.max_workers) as executor:
            future_to_code = {executor.submit(_standalone_execution_worker, task): task[0] for task in tasks}
            for future in as_completed(future_to_code):
                try:
                    res = future.result()
                    results.append(res)
                except Exception as exc:
                    results.append({
                        "success": False,
                        "error": f"Worker Exception: {str(exc)}",
                        "exec_time": 0.0,
                        "ast_nodes": 9999,
                        "code": future_to_code[future]
                    })
        return results

